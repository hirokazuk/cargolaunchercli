{
  "name": "cargolauncher2",
  "module": "src/cli.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun build ./src/cli.ts --target=bun --outfile=dist/cargolauncher2",
    "build:production": "bun build ./src/cli.ts --target=bun --outfile=dist/cli.js --production --minify",
    "build:compile": "bun build ./src/cli.ts --compile --outfile=dist/cargo-launcher",
    "clean": "rm -rf dist"
  },
  "bin": {
    "cargo-launcher": "./src/cli.ts"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
